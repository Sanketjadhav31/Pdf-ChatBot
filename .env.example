# Google API Keys for Gemini
# You can add multiple API keys to avoid rate limits
# The system will automatically rotate between them when one reaches its quota
GOOGLE_API_KEY=your-google-api-key-here
# Optional: Add more API keys (GOOGLE_API_KEY1, GOOGLE_API_KEY2, etc.)
# GOOGLE_API_KEY1=your-second-api-key-here
# GOOGLE_API_KEY2=your-third-api-key-here
# GOOGLE_API_KEY3=your-fourth-api-key-here
# GOOGLE_API_KEY4=your-fifth-api-key-here
# GOOGLE_API_KEY5=your-sixth-api-key-here

# Gemini Model Configuration
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL_NAME=models/gemini-embedding-001

# Ollama Configuration (optional)
# Set USE_OLLAMA=true to use local Ollama instead of Google Gemini
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# JWT Secret Key (CHANGE THIS IN PRODUCTION!)
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Upload Configuration
UPLOAD_CONCURRENCY=2
MAX_PDF_CHUNKS=200

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# DNS Configuration
USE_CUSTOM_DNS=true
DNS_SERVERS=8.8.8.8,8.8.4.4,1.1.1.1
FORCE_IPV4=true

# Frontend URL (for CORS in production)
FRONTEND_URL=https://your-frontend-url.netlify.app

# Vector Store Configuration
# Set to true to use Qdrant, false to use FAISS (default)
USE_QDRANT=false

# Qdrant Configuration
# For local development: http://localhost:6333
# For production (Qdrant Cloud): https://your-cluster.aws.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION=pdf_chunks

# Redis Configuration (for chat history caching)
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password-here
REDIS_MAX_MESSAGES=6
REDIS_TTL_HOURS=24
